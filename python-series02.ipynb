   ],
   "source": [
    "# =============================================\n",
    "# Final Version: Two Sinusoidal Signals\n",
    "# =============================================\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def sinusoid(frequency: float, amplitude: float, phase: float, duration: float, sampling_rate: int = 1000):\n",
    "    \"\"\"\n",
    "    Generate a sinusoidal signal.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    frequency : float\n",
    "        Frequency of the sinusoid (Hz)\n",
    "    amplitude : float\n",
    "        Amplitude of the sinusoid\n",
    "    phase : float\n",
    "        Initial phase (rad)\n",
    "    duration : float\n",
    "        Signal duration (s)\n",
    "    sampling_rate : int\n",
    "        Number of samples per second\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    time_array : numpy.ndarray\n",
    "        Time values\n",
    "    signal : numpy.ndarray\n",
    "        Sinusoidal signal\n",
    "    \"\"\"\n",
    "    # Create evenly spaced time points from 0 to duration\n",
    "    time_array = np.linspace(0, duration, int(duration * sampling_rate))\n",
    "    \n",
    "    # Compute the sine value at each time point\n",
    "    signal = amplitude * np.sin(2 * np.pi * frequency * time_array + phase)\n",
    "    \n",
    "    # Return both the time array and the signal for plotting\n",
    "    return time_array, signal\n",
    "\n",
    "# ----------------------------\n",
    "# Generate two sinusoidal signals\n",
    "# ----------------------------\n",
    "# Properties of the signals: frequency in Hz, amplitude in units, phase in radians, duration in seconds\n",
    "t1, s1 = sinusoid(frequency=1, amplitude=1, phase=0, duration=1)  # First signal: 1 Hz\n",
    "t2, s2 = sinusoid(frequency=2, amplitude=1, phase=0, duration=1)  # Second signal: 2 Hz\n",
    "\n",
    "# ----------------------------\n",
    "# Plot the signals\n",
    "# ----------------------------\n",
    "plt.figure(figsize=(8,4))  # Set figure size\n",
    "\n",
    "plt.plot(t1, s1, label=\"Sinus 1\")  # Plot first sinusoid\n",
    "plt.plot(t2, s2, label=\"Sinus 2\")  # Plot second sinusoid\n",
    "\n",
    "plt.title(\"Two Sinusoidal Signals\")  # Add title\n",
    "plt.xlabel(\"Time (s)\")               # Label x-axis\n",
    "plt.ylabel(\"Amplitude\")              # Label y-axis\n",
    "plt.grid(True)                       # Add grid for readability\n",
    "plt.legend()                         # Add legend to distinguish signals\n",
    "\n",
    "plt.show()  # Display the plot\n"
   ]
