    "def sinusoid(frequency: float, amplitude: float, phase: float, duration: float, sampling_rate: int = 1000):\n",
    "    \"\"\"\n",
    "    Generate a sinusoidal signal.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    frequency : float\n",
    "        Frequency of the sinusoid (Hz)\n",
    "    amplitude : float\n",
    "        Amplitude of the sinusoid\n",
    "    phase : float\n",
    "        Initial phase (rad)\n",
    "    duration : float\n",
    "        Signal duration (s)\n",
    "    sampling_rate : int\n",
    "        Number of samples per second\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    time_array : numpy.ndarray\n",
    "        Time values\n",
    "    signal : numpy.ndarray\n",
    "        Sinusoidal signal\n",
    "    \"\"\"\n",
    "    time_array = np.linspace(0, duration, int(duration * sampling_rate)) # Creates evenly spaced time points from 0 to duration.\n",
    "    signal = amplitude * np.sin(2 * np.pi * frequency * time_array + phase) # Computes the sine value at each time point.\n",
    "    return time_array, signal # Used for plottiing.\n",
    "\n",
    "# Properties of the two signals with their units : Hz, radians, seconds & Hz\n",
    "t1, s1 = sinusoid(frequency=1, amplitude=1, phase=0, duration=1) \n",
    "t2, s2 = sinusoid(frequency=2, amplitude=1, phase=0, duration=1) \n",
    "\n",
    "# Plot the figures\n",
    "plt.figure(figsize=(8,4))\n",
    "plt.plot(t1, s1, label=\"Sinus 1\")\n",
    "plt.plot(t2, s2, label=\"Sinus 2\")\n",
    "plt.title(\"Two sinusoidal signals\")\n",
    "plt.xlabel(\"Time (s)\")\n",
    "plt.ylabel(\"Amplitude\")\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
  },
